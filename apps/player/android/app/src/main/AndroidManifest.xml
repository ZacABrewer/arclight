<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      allowBackup=false: the app keeps sign-in tokens (Keystore) and downloaded audio; neither
      should be restored onto another device.
      networkSecurityConfig: see res/xml/network_security_config.xml (self-hosted http servers).
      banner: the Google TV / Android TV launcher tile (320x180, scripts/generate-assets.mjs).
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Google TV / Android TV home screen. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Pairing QR codes / links: arclight://pair?server=<server URL>&code=<code> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="arclight" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
          Movies & TV: the full-screen video player (playVideo). Picture-in-picture on phones only
          (the activity checks; TVs keep it off). Not exported: only the plugin starts it.
        -->
        <activity
            android:name=".video.VideoActivity"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:exported="false"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:supportsPictureInPicture="true"
            android:theme="@style/AppTheme.Video"
            tools:ignore="DiscouragedApi,LockedOrientationActivity" />

        <!--
          Native player (ArclightPlayerPlugin): Media3 MediaLibraryService for background audio,
          the media notification, lock screen, headset buttons and the Android Auto browse tree.
          Exported so system media controllers and Android Auto can bind to it; who may connect is
          decided in car/ControllerPolicy.java (this app, trusted system controllers, genuine car
          hosts; other apps are refused).
        -->
        <service
            android:name=".player.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Android Auto: this app is a media app. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Google Cast (optional at runtime; ignored when Play services are missing). -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.moviemethat.arclight.cast.CastOptionsProvider" />

        <!-- Artwork for Android Auto when it needs auth headers or is a downloaded file. -->
        <provider
            android:name=".car.ArtworkProvider"
            android:authorities="${applicationId}.artwork"
            android:exported="false"
            android:grantUriPermissions="true" />

        <!-- WorkManager's foreground service runs the download worker (dataSync on Android 14+). -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Capacitor's WebView camera capture only; scoped in res/xml/file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Streaming from the user's server; network type for Wi-Fi-only downloads and quality. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Background playback (media notification) and downloads that outlive the activity. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Android 13+: the playback and download notifications. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- QR pairing (the barcode scanner plugin asks at runtime); a camera is optional. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Google TV / Android TV: installable there, and nothing phone-only is required. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
</manifest>
