<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen video player (VideoActivity). The picture and subtitles come from Media3's PlayerView
  (its own controller is off); the overlay above it (controls, pause screen, scrub preview, skip,
  up next, the episodes and Audio & Subtitles panels, the focus ring) is built in code from the
  1280x720 design stage, see video/ui/Overlay.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="#FF000000"
        app:keep_content_on_player_reset="true" />

    <ProgressBar
        android:id="@+id/video_loading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FF6EF6FF"
        android:visibility="gone" />

    <com.moviemethat.arclight.video.ui.Overlay
        android:id="@+id/video_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />
</FrameLayout>
