<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-screen video player (VideoActivity). The picture and subtitles come from Media3's PlayerView
  (its own controller is off); everything else is our overlay: title, transport, seek bar,
  audio / subtitle / next buttons, the skip button and the up-next card. Every control is
  focusable with a visible focus ring for TV remotes.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/video_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/video_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="#FF000000"
        app:keep_content_on_player_reset="true" />

    <ProgressBar
        android:id="@+id/video_loading"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:indeterminateTint="#FF6EF6FF"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/video_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_gravity="top"
            android:background="@drawable/video_scrim_top" />

        <View
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_gravity="bottom"
            android:background="@drawable/video_scrim_bottom" />

        <!-- Top: close + titles. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp">

            <ImageButton
                android:id="@+id/video_close"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/video_round_button_bg"
                android:contentDescription="@string/video_close"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_video_close" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/video_eyebrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textAllCaps="true"
                    android:textColor="#FF6EF6FF"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/video_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#FFE9FDFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/video_stream_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="#99E9FDFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Centre: back 10 s, play / pause, forward 10 s. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/video_rewind"
                style="@style/VideoTextButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/video_back_10"
                android:text="@string/video_minus_10" />

            <ImageButton
                android:id="@+id/video_play_pause"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginStart="36dp"
                android:layout_marginEnd="36dp"
                android:background="@drawable/video_round_button_bg"
                android:contentDescription="@string/video_pause"
                android:padding="20dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_video_pause" />

            <Button
                android:id="@+id/video_forward"
                style="@style/VideoTextButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="@string/video_forward_10"
                android:text="@string/video_plus_10" />
        </LinearLayout>

        <!-- Bottom: times, seek bar, track buttons. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/video_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#FFE9FDFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/video_chapter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3E9FDFF"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/video_remaining"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="#B3E9FDFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <com.moviemethat.arclight.video.VideoSeekBar
                android:id="@+id/video_seek"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/video_audio"
                    style="@style/VideoTextButton"
                    android:text="@string/video_audio" />

                <Button
                    android:id="@+id/video_subtitles"
                    style="@style/VideoTextButton"
                    android:layout_marginStart="12dp"
                    android:text="@string/video_subtitles" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/video_next"
                    style="@style/VideoTextButton"
                    android:maxWidth="320dp"
                    android:text="@string/video_next" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- Skip intro / recap / credits: visible even while the controls are hidden. -->
    <Button
        android:id="@+id/video_skip"
        style="@style/VideoTextButton"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="132dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/video_skip_intro"
        android:visibility="gone" />

    <!-- Up next. -->
    <LinearLayout
        android:id="@+id/video_up_next"
        android:layout_width="380dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="132dp"
        android:background="@drawable/video_card_bg"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/video_up_next_art"
                android:layout_width="128dp"
                android:layout_height="72dp"
                android:layout_marginEnd="12dp"
                android:background="#1AE9FDFF"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/video_up_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.12"
                    android:textAllCaps="true"
                    android:textColor="#FF6EF6FF"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/video_up_next_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFE9FDFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/video_up_next_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3E9FDFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/video_up_next_cancel"
                style="@style/VideoTextButton"
                android:text="@string/video_cancel" />

            <Button
                android:id="@+id/video_up_next_play"
                style="@style/VideoTextButton"
                android:layout_marginStart="10dp"
                android:text="@string/video_play_now" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
