<?xml version="1.0" encoding="utf-8"?>
<!-- Video player controls: a pill with a bright focus ring (TV remotes) and a pressed state (touch). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#336EF6FF" />
            <stroke android:width="2dp" android:color="#FF6EF6FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#296EF6FF" />
            <stroke android:width="1dp" android:color="#806EF6FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="#14E9FDFF" />
            <stroke android:width="1dp" android:color="#33E9FDFF" />
        </shape>
    </item>
</selector>
