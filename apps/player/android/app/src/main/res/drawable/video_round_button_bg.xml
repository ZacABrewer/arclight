<?xml version="1.0" encoding="utf-8"?>
<!-- The big play / pause button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#4D6EF6FF" />
            <stroke android:width="3dp" android:color="#FF6EF6FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#406EF6FF" />
            <stroke android:width="2dp" android:color="#806EF6FF" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#26E9FDFF" />
            <stroke android:width="1dp" android:color="#4DE9FDFF" />
        </shape>
    </item>
</selector>
