{
  "name": "@arclight/player-app",
  "version": "0.23.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "Arclight for iOS and Android: plays music and audiobooks from your own Arclight server, with downloads for offline listening.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/generate-assets.mjs",
    "sync": "pnpm build && cap sync",
    "sync:android": "pnpm build && cap sync android",
    "sync:ios": "pnpm build && cap sync ios",
    "ios:version": "node scripts/ios-version.mjs",
    "capacitor:sync:after": "node scripts/ios-version.mjs --hook"
  },
  "dependencies": {
    "@arclight/shared": "workspace:*",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-native-biometric": "8.9.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.90.2",
    "@tanstack/react-router": "^1.170.46",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@resvg/resvg-js": "2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.12"
  }
}
