<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Used only when the build setting CARPLAY_ENABLED is YES (CODE_SIGN_ENTITLEMENTS points here
  then; it is empty otherwise). The CarPlay audio entitlement must first be granted by Apple to
  the signing team and added to the App ID's provisioning profile, or signing fails.
  See apps/player/ios/README.md.
-->
<plist version="1.0">
<dict>
	<key>com.apple.developer.carplay-audio</key>
	<true/>
</dict>
</plist>
