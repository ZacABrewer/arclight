    "@fastify/websocket": "^11.2.0",
    "@arclight/challenge-solver": "workspace:*",
    "@arclight/download-clients": "workspace:*",
    "@arclight/engine-agent": "workspace:*",
    "@arclight/indexers": "workspace:*",
    "@arclight/media-servers": "workspace:*",
    "@arclight/metadata": "workspace:*",
    "@arclight/notifications": "workspace:*",
    "@arclight/organizer": "workspace:*",
    "@arclight/parser": "workspace:*",
    "@arclight/profiles-engine": "workspace:*",
    "@arclight/shared": "workspace:*",
    "@arclight/subtitles": "workspace:*",
    "@arclight/torrent-engine": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.1.0",
    "pino": "^9.13.1",
    "tsx": "^4.20.6",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "drizzle-kit": "^0.31.5",
    "esbuild": "^0.25.12",
    "pino-pretty": "^13.1.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
