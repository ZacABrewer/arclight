{
  "name": "@media-tron/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@media-tron/download-clients": "workspace:*",
    "@media-tron/indexers": "workspace:*",
    "@media-tron/metadata": "workspace:*",
    "@media-tron/notifications": "workspace:*",
    "@media-tron/organizer": "workspace:*",
    "@media-tron/parser": "workspace:*",
    "@media-tron/profiles-engine": "workspace:*",
    "@media-tron/shared": "workspace:*",
    "better-sqlite3": "^12.4.1",
    "croner": "^9.1.0",
    "drizzle-orm": "^0.44.6",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.1.0",
    "pino": "^9.13.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "drizzle-kit": "^0.31.5",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
