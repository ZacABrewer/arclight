{
  "name": "@arclight/api",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "main": "dist/server.mjs",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node scripts/bundle.mjs",
    "start": "node dist/server.mjs",
