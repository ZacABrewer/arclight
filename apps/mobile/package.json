{
  "name": "@arclight/mobile",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0",
  "description": "Arclight Admin, the companion app for iOS and Android (Capacitor shell around the user's own Arclight server).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build -c vite.shell.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "assets": "node scripts/generate-assets.mjs",
    "licenses": "node scripts/generate-licenses.mjs",
    "sync": "pnpm build && cap sync",
    "sync:android": "pnpm build && cap sync android",
    "sync:ios": "pnpm build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.0",
    "@capacitor/device": "8.0.3",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-native-biometric": "8.9.1",
    "@capgo/capacitor-share-target": "8.0.64",
    "@fontsource/chakra-petch": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^4.1.12"
  }
}
