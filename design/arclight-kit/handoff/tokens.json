{
  "name": "Arclight",
  "version": "1.0.0",
  "color": {
    "surface": { "void": "#000000", "deep": "#02090c", "horizon": "#06222b", "glass": "rgba(12,36,44,.48)", "glass2": "rgba(2,10,14,.62)", "glassStrong": "rgba(12,36,44,.75)", "glassStrong2": "rgba(2,10,14,.92)", "field": "rgba(0,0,0,.35)" },
    "line": { "1": "rgba(110,246,255,.08)", "2": "rgba(110,246,255,.20)", "3": "rgba(110,246,255,.35)", "4": "rgba(110,246,255,.55)", "trace": "rgba(110,246,255,.50)", "edge": "rgba(200,252,255,.80)" },
    "text": { "1": "#e9fdff", "2": "#c9f9ff", "3": "#9fc3cc", "4": "#7fa6ae", "5": "#5d7f88", "label": "#8fb3bd", "placeholder": "#6f939b" },
    "accent": { "cyan": "#6ef6ff", "cyanHover": "#8ff8ff", "cyanPress": "#4fd9e3", "cyanInk": "#021014" },
    "signal": { "warn": "#ff9a4d", "warnText": "#ffc79e", "warnLine": "rgba(255,154,77,.5)", "danger": "#ff5a46", "dangerText": "#ffb3a6", "dangerLine": "rgba(255,90,70,.55)", "dangerInk": "#1a0400", "neutralLine": "rgba(143,179,189,.3)" }
  },
  "status": {
    "downloaded":  { "border": "line.3", "text": "text.2", "dot": "accent.cyan" },
    "downloading": { "border": "accent.cyan", "text": "text.1", "dot": "accent.cyan", "fill": "rgba(110,246,255,.12)", "live": true },
    "importing":   { "border": "accent.cyan", "text": "text.1", "dot": "accent.cyan", "fill": "rgba(110,246,255,.12)", "live": true },
    "monitored":   { "border": "accent.cyan", "text": "text.1", "dot": "accent.cyan", "fill": "rgba(110,246,255,.10)" },
    "unaired":     { "border": "signal.neutralLine", "text": "#8fb3bd", "dot": "ring" },
    "queued":      { "border": "signal.neutralLine", "text": "text.3", "dot": "text.5" },
    "paused":      { "border": "signal.neutralLine", "text": "text.3", "dot": "text.5" },
    "unmonitored": { "border": "rgba(143,179,189,.2)", "text": "text.5", "dot": "ring" },
    "missing":     { "border": "signal.warnLine", "text": "signal.warnText", "dot": "signal.warn" },
    "cutoffUnmet": { "border": "signal.warnLine", "text": "signal.warnText", "dot": "ring-warn" },
    "stalled":     { "border": "signal.warnLine", "text": "signal.warnText", "dot": "signal.warn", "fill": "rgba(255,154,77,.06)" },
    "failed":      { "border": "signal.dangerLine", "text": "signal.dangerText", "dot": "signal.danger", "fill": "rgba(255,90,70,.06)" }
  },
  "font": {
    "family": { "ui": "Archivo", "mono": "JetBrains Mono" },
    "scale": {
      "display":  { "size": 44, "weight": 600, "stretch": "125%", "tracking": "0.06em" },
      "titleXl":  { "size": 44, "weight": 600, "stretch": "118%" },
      "titleL":   { "size": 28, "weight": 500, "stretch": "118%" },
      "titleM":   { "size": 22, "weight": 600, "stretch": "112%" },
      "bodyL":    { "size": 16, "weight": 500 },
      "body":     { "size": 14, "weight": 400 },
      "caption":  { "size": 13, "weight": 400 },
      "label":    { "size": 11, "weight": 500, "family": "mono", "tracking": "0.24em", "case": "upper" },
      "numeric":  { "family": "mono", "tabular": true }
    }
  },
  "space": { "1": 2, "2": 4, "3": 8, "4": 12, "5": 16, "6": 20, "7": 24, "8": 28, "9": 40, "10": 56 },
  "size": { "rail": 84, "railCompact": 64, "topbar": 60, "control": 38, "controlSm": 32, "controlLg": 46, "input": 40, "chip": 24, "rowDense": 44, "rowRich": 62, "chamfer": 22, "chamferSm": 14 },
  "radius": { "default": 0, "dot": "50%", "deviceFrame": 46 },
