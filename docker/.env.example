# Copy to .env next to docker-compose.yml and adjust for the NAS.
PUID=1000
PGID=1000
TZ=America/New_York
CONFIG_ROOT=/volume1/docker
TV_ROOT=/volume1/media/tv
MOVIES_ROOT=/volume1/media/movies
DOWNLOADS_ROOT=/volume1/downloads

# VPN (docker-compose.yml only; docker-compose.novpn.yml ignores these).
# PrivateKey from a Proton WireGuard configuration with "NAT-PMP (port forwarding)" enabled.
PROTON_WIREGUARD_KEY=
# Comma-separated Proton server countries.
VPN_COUNTRIES=Netherlands
# Your LAN, so the web UIs published on gluetun stay reachable from it.
LAN_SUBNET=192.168.1.0/24

# Gluetun control-server API key; generate with scripts/gluetun-auth.sh (or .ps1), which also
# writes ${CONFIG_ROOT}/gluetun/auth/config.toml so Gluetun accepts it.
GLUETUN_API_KEY=
