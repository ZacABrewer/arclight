# Copy to .env next to docker-compose.yml and adjust the paths for your machine.
# PUID/PGID: the user and group that should own the files (`id <user>` on the host).
PUID=1000
PGID=1000
TZ=Etc/UTC
# App settings and databases (one subfolder per container).
CONFIG_ROOT=/path/to/appdata
# One share that holds downloads and the library, laid out as
#   downloads/      torrents and usenet land here
#   media/tv/       TV root folder   -> add /data/media/tv in Arclight
#   media/movies/   movie root folder -> add /data/media/movies in Arclight
# Keeping both under one mount lets imports hard-link instantly instead of copying.
DATA_ROOT=/path/to/data

# VPN (docker-compose.yml only; docker-compose.novpn.yml ignores these).
# PrivateKey from a Proton WireGuard configuration with "NAT-PMP (port forwarding)" enabled.
PROTON_WIREGUARD_KEY=
# Comma-separated Proton server countries.
VPN_COUNTRIES=Netherlands
# Your LAN, so the web UIs published on gluetun stay reachable from it.
LAN_SUBNET=192.168.1.0/24

# Gluetun control-server API key; generate with scripts/gluetun-auth.sh (or .ps1), which also
# writes ${CONFIG_ROOT}/gluetun/auth/config.toml so Gluetun accepts it.
GLUETUN_API_KEY=
