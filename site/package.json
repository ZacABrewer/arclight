{
  "name": "arclight-site",
  "private": true,
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "prepare-content": "node scripts/sync-docs.mjs && node scripts/brand-assets.mjs",
