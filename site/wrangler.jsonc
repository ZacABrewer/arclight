// Arclight website: an assets-only Worker serving the Astro build in ./dist.
// Deployed by .github/workflows/site.yml (cloudflare/wrangler-action) on pushes to main.
// Served only on the custom domain arclight.moviemethat.com (attached to the Worker once, as a
// Workers custom domain); the workers.dev address is off.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "arclight-site",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": {
    "enabled": false
  }
}
