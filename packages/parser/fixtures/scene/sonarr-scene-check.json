{
  "source": "Sonarr/src/NzbDrone.Core.Test/ParserTests/SceneCheckerFixture.cs",
  "description": "Whether a title is a well-formed scene release name.",
  "cases": [
    {
      "method": "should_return_true_for_scene_names",
      "input": "Series.Title.S04E13.Helen.Keller.The.Musical.720p.WEBRip.AAC2.0.H.264-GC",
      "expect": {
        "isSceneTitle": true
      }
    },
    {
      "method": "should_return_true_for_scene_names",
      "input": "Series.Title.S07E02.720p.WEB-DL.DD5.1.H.264-pcsyndicate",
      "expect": {
        "isSceneTitle": true
      }
    },
    {
      "method": "should_return_true_for_scene_names",
      "input": "Series.Title.2009.S05E06.Baby.Shower.720p.WEB-DL.DD5.1.H.264-iT00NZ",
      "expect": {
        "isSceneTitle": true
      }
    },
    {
      "method": "should_return_true_for_scene_names",
      "input": "Series.Title.S04E17.720p.HDTV.X264-DIMENSION",
      "expect": {
        "isSceneTitle": true
      }
    },
    {
      "method": "should_return_true_for_scene_names",
      "input": "Series.Title.S04.720p.HDTV.X264-DIMENSION",
      "expect": {
        "isSceneTitle": true
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "S08E05 - Virtual In-Stanity [WEBDL-720p]",
      "expect": {
        "isSceneTitle": false
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "S08E05 - Virtual In-Stanity.With.Dots [WEBDL-720p]",
      "expect": {
        "isSceneTitle": false
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "Something",
      "expect": {
        "isSceneTitle": false
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "86de66b7ef385e2fa56a3e41b98481ea1658bfab",
      "expect": {
        "isSceneTitle": false
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "Series.Title.S04E17.720p.HDTV.X264",
      "expect": {
        "isSceneTitle": false
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "S04E17.720p.HDTV.X264-DIMENSION",
      "expect": {
        "isSceneTitle": false
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "Series.Title.S04E17-DIMENSION",
      "expect": {
        "isSceneTitle": false
      }
    },
    {
      "method": "should_return_false_for_non_scene_names",
      "input": "Series.Title.720p.HDTV.X264-DIMENSION",
      "expect": {
        "isSceneTitle": false
      }
    }
  ]
}
