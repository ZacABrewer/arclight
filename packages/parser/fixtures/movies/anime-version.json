{
  "source": "AnimeVersionFixture.cs",
  "description": "Anime release revision/version number (v2 suffix) parsed from quality info (should_be_able_to_parse_repack)",
  "cases": [
    {
      "input": "Anime Title - 2018 - (BD 1080p HEVC FLAC) [Dual Audio] [Group]",
      "expect": {
        "version": 1
      }
    },
    {
      "input": "Anime Title - 2018v2 - (BD 1080p HEVC FLAC) [Dual Audio] [Group]",
      "expect": {
        "version": 2
      }
    },
    {
      "input": "Anime Title - 2018 v2 - (BD 1080p HEVC FLAC) [Dual Audio] [Group]",
      "expect": {
        "version": 2
      }
    },
    {
      "input": "[SubsPlease] Anime Title - 01 (1080p) [B1F227CF]",
      "expect": {
        "version": 1
      }
    },
    {
      "input": "[SubsPlease] Anime Title - 01v2 (1080p) [B1F227CF]",
      "expect": {
        "version": 2
      }
    },
    {
      "input": "[SubsPlease] Anime Title - 01 v2 (1080p) [B1F227CF]",
      "expect": {
        "version": 2
      }
    }
  ]
}
